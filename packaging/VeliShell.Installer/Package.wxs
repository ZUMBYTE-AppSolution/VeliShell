<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="VeliShell"
      Manufacturer="Zumbyte.de"
      Version="$(ProductVersion)"
      ProductCode="$(ProductCode)"
      Language="1031"
      Scope="perMachine"
      UpgradeCode="B5C35798-4912-4765-97FC-279D22D1127B"
      Compressed="yes">

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von VeliShell ist bereits installiert." />

    <Property Id="ARPCONTACT" Value="Zumbyte.de Support" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ZUMBYTE-AppSolution/VeliShell/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://zumbyte.de/" />
    <Property Id="ARPPRODUCTICON" Value="VeliShell.ico" />
    <Property Id="INSTALLLEVEL" Value="1" />
    <Icon
        Id="VeliShell.ico"
        SourceFile="$(sys.SOURCEFILEDIR)..\..\src\VeliShell.Desktop\Assets\VeliShellApp.ico" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)Assets\VeliShellInstallerDialog.png" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)Assets\VeliShellInstallerBanner.png" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="VeliShellCompanyFolder" Name="Zumbyte">
        <Directory Id="INSTALLFOLDER" Name="VeliShell">
          <!-- Static per-user verbs launch the normal EXE and never load code
               into Explorer. Runtime registration keeps portable/moved builds
               current; these MSI-owned entries are removed on uninstall. -->
          <Component Id="VeliShellFilePinVerb" Guid="99C76E93-4110-49D9-A064-B6E1B35E4C8B">
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\VeliShell.PinToDock"
                Value="Im Dock anheften" Type="string" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\VeliShell.PinToDock"
                Name="MUIVerb" Value="Im Dock anheften" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\VeliShell.PinToDock"
                Name="Icon" Value="[INSTALLFOLDER]VeliShell.exe,0" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\VeliShell.PinToDock"
                Name="MultiSelectModel" Value="Single" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\VeliShell.PinToDock"
                Name="VeliShellExecutable" Value="[INSTALLFOLDER]VeliShell.exe" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\VeliShell.PinToDock\command"
                Value="&quot;[INSTALLFOLDER]VeliShell.exe&quot; --pin-to-dock &quot;%1&quot;" Type="string" />
            <RemoveRegistryKey Id="RemoveVeliShellFilePinVerb" Root="HKCU"
                Key="Software\Classes\*\shell\VeliShell.PinToDock" Action="removeOnUninstall" />
          </Component>
          <Component Id="VeliShellDirectoryPinVerb" Guid="4BA07617-08D6-4859-A02D-F5E1B44D69BC">
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\VeliShell.PinToDock"
                Value="Im Dock anheften" Type="string" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\VeliShell.PinToDock"
                Name="MUIVerb" Value="Im Dock anheften" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\VeliShell.PinToDock"
                Name="Icon" Value="[INSTALLFOLDER]VeliShell.exe,0" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\VeliShell.PinToDock"
                Name="MultiSelectModel" Value="Single" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\VeliShell.PinToDock"
                Name="VeliShellExecutable" Value="[INSTALLFOLDER]VeliShell.exe" Type="string" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\VeliShell.PinToDock\command"
                Value="&quot;[INSTALLFOLDER]VeliShell.exe&quot; --pin-to-dock &quot;%1&quot;" Type="string" />
            <RemoveRegistryKey Id="RemoveVeliShellDirectoryPinVerb" Root="HKCU"
                Key="Software\Classes\Directory\shell\VeliShell.PinToDock" Action="removeOnUninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- In an ALLUSERS=1 per-machine package, MSI resolves ProgramMenuFolder to
         the shared Start menu. The HKCU registry value is the required MSI key
         path for this non-advertised shortcut and keeps ICE38/ICE43/ICE57 valid. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="VeliShellProgramMenuFolder" Name="VeliShell">
        <Component Id="VeliShellStartMenuShortcut" Guid="D63FA7C7-66E0-4CC7-89FB-0924E7E2BF57">
          <Shortcut
              Id="VeliShellStartMenuShortcutLink"
              Name="VeliShell"
              Description="VeliShell Dock und Windows-Styling"
              Target="[INSTALLFOLDER]VeliShell.exe"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="no" />
          <RemoveFolder Id="RemoveVeliShellProgramMenuFolder" On="uninstall" />
          <RegistryValue
              Root="HKCU"
              Key="Software\Zumbyte\VeliShell"
              Name="Installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature
        Id="VeliShellComplete"
        Title="VeliShell"
        Description="Das macOS-inspirierte Dock und die Windows-Styling-Funktionen."
        Display="expand"
        Level="1"
        AllowAbsent="no"
        AllowAdvertise="no">
      <ComponentGroupRef Id="VeliShellApplicationPayload" />
      <ComponentRef Id="VeliShellStartMenuShortcut" />
      <ComponentRef Id="VeliShellFilePinVerb" />
      <ComponentRef Id="VeliShellDirectoryPinVerb" />
    </Feature>
  </Package>
</Wix>
