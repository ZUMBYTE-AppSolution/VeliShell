<Window x:Class="VeliShell.Desktop.Views.ControlCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 xmlns:controls="clr-namespace:VeliShell.Desktop.Controls"
 Title="{services:Loc ControlCenter.Title}" Width="376" Height="536"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}"
 ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
 UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style x:Key="ConnectionRow" TargetType="Button" BasedOn="{StaticResource GlassTileButton}">
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="BorderBrush" Value="Transparent" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Padding" Value="4,6" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="StatusGlyph" TargetType="Border">
   <Setter Property="Width" Value="38" />
   <Setter Property="Height" Value="38" />
   <Setter Property="CornerRadius" Value="19" />
   <Setter Property="Background" Value="{DynamicResource GlassIconSurface}" />
  </Style>
  <Style x:Key="CompactTile" TargetType="Button" BasedOn="{StaticResource GlassTileButton}">
   <Setter Property="Padding" Value="11" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
 </Window.Resources>

 <Border Margin="8" Background="{DynamicResource GlassPanelSurface}" CornerRadius="24"
         BorderBrush="{DynamicResource GlassPanelStroke}" BorderThickness="1" Padding="1">
  <Border.Effect>
   <DropShadowEffect Color="{DynamicResource GlassShadowColor}" BlurRadius="34" ShadowDepth="9" Opacity="0.58" />
  </Border.Effect>
  <Grid ClipToBounds="True">
   <Border Background="{DynamicResource DockMilkOverlay}" CornerRadius="23" IsHitTestVisible="False" />
   <Ellipse Width="310" Height="250" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="-180,-155,0,0" Fill="{DynamicResource AmbientGlowGradient}" Opacity="0.12"
            IsHitTestVisible="False">
    <Ellipse.Effect><BlurEffect Radius="54" /></Ellipse.Effect>
   </Ellipse>
   <Border Height="1" Margin="25,1" VerticalAlignment="Top" CornerRadius="0.5"
           Background="{DynamicResource GlassHighlight}" Opacity="0.72" IsHitTestVisible="False" />

   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 CanContentScroll="False">
    <Grid Margin="13,10,13,14">
     <Grid.RowDefinitions>
      <RowDefinition Height="43" />
      <RowDefinition Height="184" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>

     <Grid Margin="5,0,4,4">
      <TextBlock Text="{services:Loc ControlCenter.Title}" FontSize="18" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <controls:VeliSymbol Symbol="ControlCenter" Width="17" Height="17"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
     </Grid>

     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="1.35*" />
       <ColumnDefinition Width="0.85*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource GlassCard}" Padding="7" Margin="0,0,5,0">
       <Grid>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
        <Button Style="{StaticResource ConnectionRow}" Click="Network_Click"
                AutomationProperties.Name="{services:Loc ControlCenter.Network}">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource StatusGlyph}" VerticalAlignment="Center">
           <controls:VeliSymbol Symbol="Network" Width="21" Height="21"
                                Foreground="{DynamicResource GlassIconForeground}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
           <TextBlock Text="{services:Loc ControlCenter.Network}" FontSize="13" FontWeight="SemiBold" />
           <TextBlock x:Name="NetworkStatus" Style="{StaticResource SecondaryText}" FontSize="11" />
          </StackPanel>
         </Grid>
        </Button>
        <Border Grid.Row="1" Height="1" Margin="50,0,5,0" VerticalAlignment="Top"
                Background="{DynamicResource GlassSeparator}" />
        <Button Grid.Row="1" Style="{StaticResource ConnectionRow}" Click="Bluetooth_Click"
                AutomationProperties.Name="{services:Loc ControlCenter.Bluetooth}">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource StatusGlyph}" VerticalAlignment="Center">
           <controls:VeliSymbol Symbol="Bluetooth" Width="21" Height="21"
                                Foreground="{DynamicResource GlassIconForeground}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
           <TextBlock Text="{services:Loc ControlCenter.Bluetooth}" FontSize="13" FontWeight="SemiBold" />
           <TextBlock Text="{services:Loc ControlCenter.OpenSettings}" Style="{StaticResource SecondaryText}" FontSize="11" />
          </StackPanel>
         </Grid>
        </Button>
       </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="5,0,0,0">
       <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
       <Button Style="{StaticResource CompactTile}" Margin="0,0,0,5" Click="Focus_Click"
               AutomationProperties.Name="{services:Loc ControlCenter.Focus}">
        <Grid>
         <Border Style="{StaticResource StatusGlyph}" HorizontalAlignment="Left" VerticalAlignment="Top">
          <controls:VeliSymbol Symbol="Focus" Width="20" Height="20"
                               Foreground="{DynamicResource GlassIconForeground}" />
         </Border>
         <TextBlock Text="{services:Loc ControlCenter.Focus}" FontWeight="SemiBold"
                    VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
        </Grid>
       </Button>
       <Button Grid.Row="1" Style="{StaticResource CompactTile}" Margin="0,5,0,0" Click="Display_Click"
               AutomationProperties.Name="{services:Loc ControlCenter.Display}">
        <Grid>
         <Border Style="{StaticResource StatusGlyph}" HorizontalAlignment="Left" VerticalAlignment="Top">
          <controls:VeliSymbol Symbol="Display" Width="20" Height="20"
                               Foreground="{DynamicResource GlassIconForeground}" />
         </Border>
         <TextBlock Text="{services:Loc ControlCenter.Display}" FontWeight="SemiBold"
                    VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
        </Grid>
       </Button>
      </Grid>
     </Grid>

     <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="14,11" Margin="0,10,0,0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <controls:VeliSymbol Symbol="Sound" Width="17" Height="17"
                              Foreground="{DynamicResource TextPrimary}" Margin="0,0,7,0" />
         <TextBlock Text="{services:Loc ControlCenter.Sound}" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
         <TextBlock x:Name="VolumeLabel" Foreground="{DynamicResource TextSecondary}"
                    VerticalAlignment="Center" Margin="0,0,8,0" />
         <CheckBox x:Name="MuteSwitch" Content="{services:Loc ControlCenter.Mute}"
                   Style="{StaticResource ToggleSwitch}" Click="Mute_Click"
                   ToolTip="{services:Loc ControlCenter.Mute}">
          <CheckBox.Template>
           <ControlTemplate TargetType="CheckBox">
            <Border x:Name="MuteBody" Width="30" Height="30" CornerRadius="15"
                    Background="{DynamicResource GlassControlSurface}"
                    BorderBrush="{DynamicResource GlassCardStroke}" BorderThickness="1">
             <controls:VeliSymbol Symbol="Sound" Width="15" Height="15"
                                  Foreground="{DynamicResource TextPrimary}" />
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsChecked" Value="True"><Setter TargetName="MuteBody" Property="Opacity" Value="0.42" /></Trigger>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MuteBody" Property="Background" Value="{DynamicResource GlassControlHover}" /></Trigger>
             <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </CheckBox.Template>
         </CheckBox>
        </StackPanel>
       </Grid>
       <Slider Grid.Row="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="0,5,0,0"
               ValueChanged="VolumeSlider_ValueChanged"
               AutomationProperties.Name="{services:Loc ControlCenter.Volume}" />
       <Button Grid.Row="2" Style="{StaticResource GlassTileButton}"
               Content="{services:Loc AudioDevices.Show}" Padding="8,5" Margin="0,7,0,0"
               Click="AudioDevices_Click" />
      </Grid>
     </Border>

     <Button Grid.Row="3" Style="{StaticResource GlassTileButton}" Margin="0,10,0,0" Padding="12,10"
             HorizontalContentAlignment="Stretch" Click="Power_Click"
             AutomationProperties.Name="{services:Loc ControlCenter.Power}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource GlassControlSurface}">
        <controls:VeliSymbol Symbol="Battery" Width="18" Height="18" Foreground="{DynamicResource TextPrimary}" />
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{services:Loc ControlCenter.Power}" FontSize="13" FontWeight="SemiBold" />
        <TextBlock x:Name="PowerStatus" Style="{StaticResource SecondaryText}" FontSize="11" />
       </StackPanel>
       <controls:VeliSymbol Grid.Column="2" Symbol="ChevronRight" Width="14" Height="14"
                            Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
      </Grid>
     </Button>

     <Button Grid.Row="4" Style="{StaticResource GlassTileButton}"
             Content="{services:Loc ControlCenter.AllSettings}" Margin="0,10,0,0" Padding="12,9"
             Click="Settings_Click" />
    </Grid>
   </ScrollViewer>
  </Grid>
 </Border>
</Window>
