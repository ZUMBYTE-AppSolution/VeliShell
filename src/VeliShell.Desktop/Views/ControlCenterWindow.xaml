<Window x:Class="VeliShell.Desktop.Views.ControlCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 xmlns:controls="clr-namespace:VeliShell.Desktop.Controls"
 Title="{services:Loc ControlCenter.Title}" Width="376" Height="536"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}"
 ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
 UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style x:Key="QuickAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinHeight" Value="86" />
   <Setter Property="Padding" Value="13" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="RoundGlyph" TargetType="Border">
   <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" />
   <Setter Property="CornerRadius" Value="17" /><Setter Property="Background" Value="{DynamicResource AccentGradient}" />
   <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
 </Window.Resources>
 <Border Background="{DynamicResource DockSurfaceGradient}" CornerRadius="18"
         BorderBrush="{DynamicResource DockStroke}" BorderThickness="1" Padding="1">
  <Border.Effect>
   <DropShadowEffect Color="{DynamicResource SubtleShadowColor}" BlurRadius="30" ShadowDepth="8" Opacity="0.48" />
  </Border.Effect>
  <Grid ClipToBounds="True">
   <Border Background="{DynamicResource DockMilkOverlay}" CornerRadius="17" IsHitTestVisible="False" />
   <Ellipse Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-185,-135,0" Fill="{DynamicResource AmbientGlowGradient}" Opacity="0.14" IsHitTestVisible="False">
    <Ellipse.Effect><BlurEffect Radius="46" /></Ellipse.Effect>
   </Ellipse>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
    <Grid Margin="14">
    <Grid.RowDefinitions>
     <RowDefinition Height="48" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{services:Loc ControlCenter.Title}" FontSize="20" FontWeight="SemiBold"
               Margin="6,0" VerticalAlignment="Center" />

    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
     <Button Style="{StaticResource QuickAction}" Margin="0,0,5,5" Click="Network_Click"
             AutomationProperties.Name="{services:Loc ControlCenter.Network}">
      <StackPanel>
       <Border Style="{StaticResource RoundGlyph}">
        <controls:VeliSymbol Symbol="Network" Width="20" Height="20" Foreground="White" />
       </Border>
       <TextBlock Text="{services:Loc ControlCenter.Network}" FontWeight="SemiBold" Margin="0,7,0,0" />
       <TextBlock x:Name="NetworkStatus" Style="{StaticResource SecondaryText}" />
      </StackPanel>
     </Button>
     <Button Grid.Column="1" Style="{StaticResource QuickAction}" Margin="5,0,0,5" Click="Bluetooth_Click"
             AutomationProperties.Name="{services:Loc ControlCenter.Bluetooth}">
      <StackPanel>
       <Border Style="{StaticResource RoundGlyph}">
        <controls:VeliSymbol Symbol="Bluetooth" Width="20" Height="20" Foreground="White" />
       </Border>
       <TextBlock Text="{services:Loc ControlCenter.Bluetooth}" FontWeight="SemiBold" Margin="0,7,0,0" />
       <TextBlock Text="{services:Loc ControlCenter.OpenSettings}" Style="{StaticResource SecondaryText}" />
      </StackPanel>
     </Button>
     <Button Grid.Row="1" Style="{StaticResource QuickAction}" Margin="0,5,5,0" Click="Focus_Click"
             AutomationProperties.Name="{services:Loc ControlCenter.Focus}">
      <StackPanel>
       <Border Style="{StaticResource RoundGlyph}">
        <controls:VeliSymbol Symbol="Focus" Width="20" Height="20" Foreground="White" />
       </Border>
       <TextBlock Text="{services:Loc ControlCenter.Focus}" FontWeight="SemiBold" Margin="0,7,0,0" />
       <TextBlock Text="{services:Loc ControlCenter.OpenSettings}" Style="{StaticResource SecondaryText}" />
      </StackPanel>
     </Button>
     <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource QuickAction}" Margin="5,5,0,0" Click="Display_Click"
             AutomationProperties.Name="{services:Loc ControlCenter.Display}">
      <StackPanel>
       <Border Style="{StaticResource RoundGlyph}">
        <controls:VeliSymbol Symbol="Display" Width="20" Height="20" Foreground="White" />
       </Border>
       <TextBlock Text="{services:Loc ControlCenter.Display}" FontWeight="SemiBold" Margin="0,7,0,0" />
       <TextBlock Text="{services:Loc ControlCenter.OpenSettings}" Style="{StaticResource SecondaryText}" />
      </StackPanel>
     </Button>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
     <StackPanel>
      <Grid>
       <StackPanel Orientation="Horizontal">
        <controls:VeliSymbol Symbol="Sound" Width="17" Height="17" Foreground="{DynamicResource TextPrimary}" Margin="0,0,7,0" />
        <TextBlock Text="{services:Loc ControlCenter.Sound}" FontSize="14" FontWeight="SemiBold" />
       </StackPanel>
       <TextBlock x:Name="VolumeLabel" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" />
      </Grid>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="0,7,0,1"
              ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="{services:Loc ControlCenter.Volume}" />
      <CheckBox x:Name="MuteSwitch" Content="{services:Loc ControlCenter.Mute}" Style="{StaticResource ToggleSwitch}"
                Click="Mute_Click" />
     </StackPanel>
    </Border>

    <Button Grid.Row="3" Margin="0,12,0,0" Padding="14,11" HorizontalContentAlignment="Stretch"
            Click="Power_Click" AutomationProperties.Name="{services:Loc ControlCenter.Power}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
       <StackPanel Orientation="Horizontal">
        <controls:VeliSymbol Symbol="Battery" Width="17" Height="17" Foreground="{DynamicResource TextPrimary}" Margin="0,0,7,0" />
        <TextBlock Text="{services:Loc ControlCenter.Power}" FontSize="14" FontWeight="SemiBold" />
       </StackPanel>
       <TextBlock x:Name="PowerStatus" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
      </StackPanel>
      <controls:VeliSymbol Grid.Column="1" Symbol="ChevronRight" Width="15" Height="15"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Margin="12,0,2,0" />
     </Grid>
    </Button>

    <Button Grid.Row="4" Content="{services:Loc ControlCenter.AllSettings}" Margin="0,12,0,0"
            Click="Settings_Click" />
    </Grid>
    </ScrollViewer>
   </Grid>
 </Border>
</Window>
