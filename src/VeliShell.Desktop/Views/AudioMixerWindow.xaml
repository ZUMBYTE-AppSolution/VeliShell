<Window x:Class="VeliShell.Desktop.Views.AudioMixerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 xmlns:controls="clr-namespace:VeliShell.Desktop.Controls"
 Title="{services:Loc AudioDevices.MixerTitle}" Width="570" Height="660"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="Manual" UseLayoutRounding="True" KeyDown="Window_KeyDown">
 <Border x:Name="GlassPlate" Margin="8" Background="{DynamicResource GlassPanelSurface}" CornerRadius="24"
         BorderBrush="{DynamicResource GlassPanelStroke}" BorderThickness="1" Padding="1">
  <Border.Effect><DropShadowEffect Color="{DynamicResource GlassShadowColor}" BlurRadius="10" ShadowDepth="1" Opacity="0.42" /></Border.Effect>
  <Grid controls:RoundedClip.Radius="23">
   <Border Background="{DynamicResource DockMilkOverlay}" CornerRadius="23" IsHitTestVisible="False" />
   <Grid Margin="20,18,20,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel>
     <Button DockPanel.Dock="Right" Style="{StaticResource GlassCircleButton}"
             Width="32" Height="30" Click="Close_Click"
             AutomationProperties.Name="{services:Loc Common.Close}">
      <controls:VeliSymbol Symbol="Close" Width="15" Height="15"
                           Foreground="{DynamicResource TextPrimary}" />
     </Button>
     <TextBlock Text="{services:Loc AudioDevices.MixerTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <TextBlock Grid.Row="1" Text="{services:Loc AudioDevices.MixerHint}" Foreground="{DynamicResource TextSecondary}"
               TextWrapping="Wrap" Margin="0,6,0,14" />
    <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,15">
     <StackPanel>
      <TextBlock Text="{services:Loc AudioDevices.Outputs}" FontWeight="SemiBold" />
      <ComboBox x:Name="OutputChoice" Margin="0,8,0,13" SelectionChanged="OutputChoice_SelectionChanged" />
      <DockPanel><TextBlock Text="{services:Loc AudioDevices.MasterVolume}" />
       <TextBlock x:Name="MasterVolumeLabel" HorizontalAlignment="Right" /></DockPanel>
      <Slider x:Name="MasterSlider" Minimum="0" Maximum="100" ValueChanged="MasterSlider_ValueChanged"
              Margin="0,9,0,0" AutomationProperties.Name="{services:Loc AudioDevices.MasterVolume}" />
     </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
     <Expander x:Name="SessionsExpander" Header="{services:Loc AudioDevices.AppVolumes}"
               Style="{StaticResource GlassExpander}" IsExpanded="True"
               Expanded="Sessions_Changed" Collapsed="Sessions_Changed">
      <StackPanel x:Name="SessionsPanel" />
     </Expander>
    </ScrollViewer>
    <Button Grid.Row="4" Content="{services:Loc Common.Refresh}" Click="Refresh_Click"
            HorizontalAlignment="Right" Padding="14,8" Margin="0,12,0,0" />
   </Grid>
  </Grid>
 </Border>
</Window>
