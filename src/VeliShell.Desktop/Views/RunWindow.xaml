<Window x:Class="VeliShell.Desktop.Views.RunWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 Title="{services:Loc MenuBar.Run}" Width="450" Height="205"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
 <Border Margin="9" Background="{DynamicResource GlassPanelSurface}" CornerRadius="21"
         BorderBrush="{DynamicResource GlassPanelStroke}" BorderThickness="1" Padding="22">
  <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="7" Opacity="0.5" /></Border.Effect>
  <StackPanel>
   <TextBlock Text="{services:Loc MenuBar.Run}" FontSize="19" FontWeight="SemiBold" />
   <TextBlock Text="{services:Loc MenuBar.RunPrompt}" Foreground="{DynamicResource TextSecondary}"
              Margin="0,8,0,12" />
   <TextBox x:Name="CommandBox" FontSize="14" Padding="9,7" MaxLength="2048"
            AutomationProperties.Name="{services:Loc MenuBar.RunPrompt}" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
    <Button Content="{services:Loc Common.Cancel}" Padding="13,6" Margin="0,0,8,0" Click="Cancel_Click" />
    <Button Content="{services:Loc MenuBar.Run}" Style="{StaticResource PrimaryButton}"
            Padding="13,6" Click="Run_Click" />
   </StackPanel>
  </StackPanel>
 </Border>
</Window>
