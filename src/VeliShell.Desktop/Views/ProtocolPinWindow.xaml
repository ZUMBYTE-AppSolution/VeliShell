<Window x:Class="VeliShell.Desktop.Views.ProtocolPinWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 Title="{services:Loc Dock.PinProtocol}" Width="440" Height="220"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" UseLayoutRounding="True" KeyDown="Window_KeyDown">
 <Border Margin="9" Background="{DynamicResource GlassPanelSurface}" CornerRadius="21"
         BorderBrush="{DynamicResource GlassPanelStroke}" BorderThickness="1" Padding="1">
  <Border.Effect><DropShadowEffect Color="{DynamicResource GlassShadowColor}" BlurRadius="10"
                                   ShadowDepth="1" Opacity="0.42" /></Border.Effect>
  <Grid>
   <Border Background="{DynamicResource DockMilkOverlay}" CornerRadius="20" IsHitTestVisible="False" />
   <StackPanel Margin="22,20,22,20">
    <TextBlock Text="{services:Loc Dock.PinProtocol}" FontSize="19" FontWeight="SemiBold" />
    <TextBlock Text="{services:Loc Dock.PinProtocolHint}" FontSize="11.5"
               Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,13" />
    <Border Background="{DynamicResource GlassControlSurface}" BorderBrush="{DynamicResource GlassCardStroke}"
            BorderThickness="1" CornerRadius="12" Padding="9,7">
     <TextBox x:Name="ProtocolBox" BorderThickness="0" Background="Transparent" FontSize="14"
              MaxLength="2048" AutomationProperties.Name="{services:Loc Dock.PinProtocol}" />
    </Border>
    <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource TextSecondary}"
               FontSize="11" Margin="0,5,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
     <Button Content="{services:Loc Common.Cancel}" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click" />
     <Button Content="{services:Loc FolderPopover.SaveName}" Style="{StaticResource PrimaryButton}"
             Padding="16,7" Click="Save_Click" />
    </StackPanel>
   </StackPanel>
  </Grid>
 </Border>
</Window>
