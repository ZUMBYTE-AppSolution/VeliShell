<Window x:Class="VeliShell.Desktop.Views.VirtualFolderNameWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 Title="{services:Loc FolderPopover.NameTitle}" Width="390" Height="216"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" UseLayoutRounding="True" KeyDown="Window_KeyDown">
 <Border Margin="9" Background="{DynamicResource GlassPanelSurface}" CornerRadius="21"
         BorderBrush="{DynamicResource GlassPanelStroke}" BorderThickness="1" Padding="1">
  <Border.Effect><DropShadowEffect Color="{DynamicResource GlassShadowColor}" BlurRadius="34"
                                   ShadowDepth="8" Opacity="0.6" /></Border.Effect>
  <Grid ClipToBounds="True">
   <Border Background="{DynamicResource DockMilkOverlay}" CornerRadius="20" IsHitTestVisible="False" />
   <Ellipse Width="280" Height="210" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-145,-120,0" Fill="{DynamicResource AmbientGlowGradient}" Opacity="0.12"
            IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="42" /></Ellipse.Effect></Ellipse>
   <StackPanel Margin="22,20,22,20">
    <TextBlock x:Name="TitleText" Text="{services:Loc FolderPopover.NameTitle}"
               FontSize="19" FontWeight="SemiBold" />
    <TextBlock Text="{services:Loc FolderPopover.NameHint}" FontSize="11.5"
               Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,13" />
    <Border Background="{DynamicResource GlassControlSurface}" BorderBrush="{DynamicResource GlassCardStroke}"
            BorderThickness="1" CornerRadius="12" Padding="9,7">
     <TextBox x:Name="NameBox" BorderThickness="0" Background="Transparent" FontSize="15"
              MaxLength="64" AutomationProperties.Name="{services:Loc FolderPopover.NameLabel}" />
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
     <Button Content="{services:Loc Common.Cancel}" Padding="14,7" Margin="0,0,8,0"
             Click="Cancel_Click" />
     <Button Content="{services:Loc FolderPopover.SaveName}" Style="{StaticResource PrimaryButton}"
             Padding="16,7" Click="Save_Click" />
    </StackPanel>
   </StackPanel>
  </Grid>
 </Border>
</Window>
