<Window x:Class="VeliShell.Desktop.Views.VirtualFolderNameWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 xmlns:controls="clr-namespace:VeliShell.Desktop.Controls"
 Title="{services:Loc FolderPopover.NameTitle}" Width="430" MinWidth="360" MinHeight="240"
 SizeToContent="Height"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="Manual" UseLayoutRounding="True" KeyDown="Window_KeyDown">
 <Border x:Name="GlassPlate" Margin="9" Background="{DynamicResource GlassPanelSurface}" CornerRadius="21"
         BorderBrush="{DynamicResource GlassPanelStroke}" BorderThickness="1" Padding="1">
  <Border.Effect><DropShadowEffect Color="{DynamicResource GlassShadowColor}" BlurRadius="10"
                                   ShadowDepth="1" Opacity="0.42" /></Border.Effect>
  <Grid controls:RoundedClip.Radius="20">
   <Border Background="{DynamicResource DockMilkOverlay}" CornerRadius="20" IsHitTestVisible="False" />
   <Ellipse Width="280" Height="210" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-145,-120,0" Fill="{DynamicResource AmbientGlowGradient}" Opacity="0.12"
            IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="42" /></Ellipse.Effect></Ellipse>
   <Grid Margin="22,20,22,20">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="TitleText" Grid.Row="0" Text="{services:Loc FolderPopover.NameTitle}"
               FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Text="{services:Loc FolderPopover.NameHint}" FontSize="11.5"
               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,13" />
    <Border Grid.Row="2" Background="{DynamicResource GlassControlSurface}" BorderBrush="{DynamicResource GlassCardStroke}"
            BorderThickness="1" CornerRadius="12" Padding="9,7">
     <TextBox x:Name="NameBox" BorderThickness="0" Background="Transparent" FontSize="15"
              MaxLength="64" AutomationProperties.Name="{services:Loc FolderPopover.NameLabel}" />
    </Border>
    <Grid Grid.Row="3" Margin="0,18,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <Button x:Name="CancelButton" Grid.Column="1" Content="{services:Loc Common.Cancel}" Style="{StaticResource GlassDialogButton}" MinWidth="110" MinHeight="40"
             Padding="16,9" Margin="0,0,9,0" Click="Cancel_Click" />
     <Button x:Name="SaveButton" Grid.Column="2" Content="{services:Loc FolderPopover.SaveName}" Style="{StaticResource GlassDialogButton}" FontWeight="SemiBold"
             MinWidth="110" MinHeight="40" Padding="16,9" Click="Save_Click" />
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
