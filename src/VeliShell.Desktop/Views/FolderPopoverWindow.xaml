<Window x:Class="VeliShell.Desktop.Views.FolderPopoverWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 xmlns:controls="clr-namespace:VeliShell.Desktop.Controls"
 Title="{services:Loc FolderPopover.Title}" Width="420" Height="480" MinWidth="320" MinHeight="260"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
 AllowDrop="True" DragOver="VirtualFolder_DragOver" Drop="VirtualFolder_Drop"
 KeyDown="Window_KeyDown">
 <Border Margin="8" Background="{DynamicResource GlassPanelSurface}" CornerRadius="24"
         BorderBrush="{DynamicResource GlassPanelStroke}" BorderThickness="1" Padding="1">
  <Border.Effect>
   <DropShadowEffect Color="{DynamicResource GlassShadowColor}" BlurRadius="34" ShadowDepth="9" Opacity="0.58" />
  </Border.Effect>
  <Grid ClipToBounds="True">
   <Border Background="{DynamicResource DockMilkOverlay}" CornerRadius="23" IsHitTestVisible="False" />
   <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-205,-140,0" Fill="{DynamicResource AmbientGlowGradient}" Opacity="0.14"
            IsHitTestVisible="False">
    <Ellipse.Effect><BlurEffect Radius="48" /></Ellipse.Effect>
   </Ellipse>
   <Border Height="1" Margin="25,1" VerticalAlignment="Top" CornerRadius="0.5"
           Background="{DynamicResource GlassHighlight}" Opacity="0.72" IsHitTestVisible="False" />
   <Grid Margin="14,12,14,15">
    <Grid.RowDefinitions>
     <RowDefinition Height="48" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Button x:Name="BackButton" Style="{StaticResource GlassCircleButton}"
             Width="36" Height="36" Padding="8" Margin="0,0,10,0"
             Click="Back_Click" AutomationProperties.Name="{services:Loc FolderPopover.Back}">
      <controls:VeliSymbol Symbol="ArrowLeft" Width="17" Height="17"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
     </Button>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="{services:Loc FolderPopover.Title}" FontSize="11"
                 Foreground="{DynamicResource TextSecondary}" />
      <TextBlock x:Name="PathTitle" FontSize="18" FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
     </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  Margin="2,3,2,10">
     <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" />
    </ScrollViewer>

    <Grid Grid.Row="2">
     <ScrollViewer x:Name="ItemsScroller" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled">
      <Grid>
       <StackPanel x:Name="ItemsPanel" />
       <WrapPanel x:Name="GridItemsPanel" Visibility="Collapsed" />
      </Grid>
     </ScrollViewer>
     <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                 MaxWidth="300" Visibility="Collapsed">
      <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource GlassControlSurface}"
              BorderBrush="{DynamicResource GlassCardStroke}" BorderThickness="1" HorizontalAlignment="Center">
       <controls:VeliSymbol x:Name="StateSymbol" Symbol="Folder" Width="24" Height="24"
                            Foreground="{DynamicResource TextPrimary}" />
      </Border>
      <TextBlock x:Name="StateTitle" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                 HorizontalAlignment="Center" Margin="0,14,0,5" />
      <TextBlock x:Name="StateDescription" Foreground="{DynamicResource TextSecondary}"
                 TextAlignment="Center" TextWrapping="Wrap" />
     </StackPanel>
    </Grid>

    <Grid Grid.Row="3" Margin="2,12,2,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}"
                VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0" />
     <Button x:Name="OpenExplorerButton" Grid.Column="1" Style="{StaticResource GlassTileButton}" Padding="12,7" Click="OpenExplorer_Click"
             AutomationProperties.Name="{services:Loc FolderPopover.OpenExplorer}">
      <StackPanel Orientation="Horizontal">
       <controls:VeliSymbol Symbol="External" Width="15" Height="15" Margin="0,0,7,0"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
       <TextBlock Text="{services:Loc FolderPopover.OpenExplorer}" />
      </StackPanel>
     </Button>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
