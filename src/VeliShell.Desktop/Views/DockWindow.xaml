<Window x:Class="VeliShell.Desktop.Views.DockWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 Title="{services:Loc Product.Name}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
 Width="600" Height="150" UseLayoutRounding="True" AllowDrop="True"
 DragEnter="Dock_DragEnter" DragOver="Dock_DragOver" DragLeave="Dock_DragLeave" Drop="Dock_Drop"
 PreviewMouseWheel="Dock_PreviewMouseWheel" MouseMove="Dock_MouseMove"
 MouseEnter="Dock_MouseEnter" MouseLeave="Dock_MouseLeave" MouseRightButtonUp="Dock_RightClick">
 <Grid Background="{x:Null}">
  <Grid x:Name="DockBody" VerticalAlignment="Bottom" Margin="16,0,16,12">
   <Grid.RenderTransform><TranslateTransform x:Name="Slide" /></Grid.RenderTransform>
   <Border x:Name="DockPlate" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,4"
   Background="{DynamicResource DockSurfaceGradient}" BorderBrush="{DynamicResource DockStroke}"
    BorderThickness="1" CornerRadius="11">
    <Border.Effect><DropShadowEffect BlurRadius="19" ShadowDepth="4" Opacity="0.22" /></Border.Effect>
    <Grid ClipToBounds="True">
     <Border Margin="1" Background="{DynamicResource DockMilkOverlay}"
      CornerRadius="9.5" IsHitTestVisible="False" />
     <Border Margin="1" BorderBrush="{DynamicResource DockInnerStroke}" BorderThickness="1"
      CornerRadius="9.5" IsHitTestVisible="False" />
     <Border Height="1" Margin="25,1,25,0" VerticalAlignment="Top"
      Background="{DynamicResource DockHighlight}" CornerRadius="0.5" IsHitTestVisible="False" />
    </Grid>
   </Border>
   <StackPanel x:Name="ItemsPanel" Orientation="Horizontal" VerticalAlignment="Bottom"
    HorizontalAlignment="Center" Margin="12,0,12,9" ClipToBounds="False" />
   <Border x:Name="DropMarker" Width="4" Height="54" HorizontalAlignment="Left"
    VerticalAlignment="Bottom" Margin="24,0,0,17" CornerRadius="2"
    Background="{DynamicResource DockDropMarker}" Visibility="Collapsed" IsHitTestVisible="False">
    <Border.Effect><DropShadowEffect Color="#AA007AFF" BlurRadius="8" ShadowDepth="0" Opacity="0.72" /></Border.Effect>
   </Border>
  </Grid>
  <Grid x:Name="RevealHandle" Height="14" VerticalAlignment="Bottom" Margin="16,0,16,0"
   Background="Transparent" Visibility="Collapsed">
   <Border Width="64" Height="5" CornerRadius="2.5" VerticalAlignment="Bottom" Margin="0,0,0,3"
    Background="{DynamicResource DockIndicator}" Opacity="0.45" IsHitTestVisible="False" />
  </Grid>
 </Grid>
</Window>
