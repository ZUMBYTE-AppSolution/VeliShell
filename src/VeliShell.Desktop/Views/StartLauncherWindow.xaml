<Window x:Class="VeliShell.Desktop.Views.StartLauncherWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 xmlns:controls="clr-namespace:VeliShell.Desktop.Controls"
 Title="{services:Loc Start.Title}" Width="610" Height="640" MinWidth="410" MinHeight="380"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
 KeyDown="Window_KeyDown">
 <Border Margin="9" Background="{DynamicResource GlassPanelSurface}" CornerRadius="23"
         BorderBrush="{DynamicResource GlassPanelStroke}" BorderThickness="1" Padding="1">
  <Border.Effect>
   <DropShadowEffect Color="{DynamicResource GlassShadowColor}" BlurRadius="36" ShadowDepth="9" Opacity="0.62" />
  </Border.Effect>
  <Grid ClipToBounds="True">
   <Border Background="{DynamicResource DockMilkOverlay}" CornerRadius="22" IsHitTestVisible="False" />
   <Ellipse Width="360" Height="280" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-185,-150,0" Fill="{DynamicResource AmbientGlowGradient}" Opacity="0.14"
            IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="52" /></Ellipse.Effect></Ellipse>
   <Border Height="1" Margin="27,1" VerticalAlignment="Top" Background="{DynamicResource GlassHighlight}"
           Opacity="0.75" IsHitTestVisible="False" />
   <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="2,0,2,14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="{services:Loc Start.Eyebrow}" Foreground="{DynamicResource TextSecondary}"
                 FontSize="11" FontWeight="SemiBold" />
      <TextBlock Text="{services:Loc Start.Title}" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0" />
     </StackPanel>
     <Border Grid.Column="1" Width="40" Height="40" CornerRadius="13"
             Background="{DynamicResource GlassControlSurface}" BorderBrush="{DynamicResource GlassCardStroke}"
             BorderThickness="1" VerticalAlignment="Center">
      <controls:VeliSymbol Symbol="Apps" Width="21" Height="21" Foreground="{DynamicResource TextPrimary}" />
     </Border>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource GlassControlSurface}"
            BorderBrush="{DynamicResource GlassCardStroke}" BorderThickness="1" CornerRadius="14"
            Padding="12,8" Margin="0,0,0,13">
     <DockPanel>
      <controls:VeliSymbol Symbol="Search" Width="18" Height="18" DockPanel.Dock="Left"
                           Margin="0,0,9,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" />
      <TextBox x:Name="QueryBox" Background="Transparent" BorderThickness="0" FontSize="15"
               VerticalContentAlignment="Center" TextChanged="QueryBox_TextChanged"
               AutomationProperties.Name="{services:Loc Start.Search}" />
     </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <StackPanel x:Name="PinnedSection" Margin="0,0,0,13">
       <TextBlock Text="{services:Loc Start.Pinned}" FontSize="12" FontWeight="SemiBold"
                  Margin="3,0,0,9" Foreground="{DynamicResource TextSecondary}" />
       <WrapPanel x:Name="PinnedPanel" />
      </StackPanel>
      <Grid Margin="3,2,3,8">
       <TextBlock x:Name="ListHeading" Text="{services:Loc Start.AllApps}"
                  FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
       <TextBlock x:Name="ResultCount" HorizontalAlignment="Right" FontSize="11"
                  Foreground="{DynamicResource TextSecondary}" />
      </Grid>
      <StackPanel x:Name="AppsPanel" />
      <Button x:Name="MoreButton" Style="{StaticResource GlassTileButton}"
              Content="{services:Loc Start.More}" Margin="0,8,0,3" Padding="10,9"
              Visibility="Collapsed" Click="More_Click" />
     </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="3" Margin="2,14,2,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="UserLabel" FontSize="12" FontWeight="SemiBold" />
      <TextBlock Text="{services:Loc Start.DragHint}" FontSize="10.5"
                 Foreground="{DynamicResource TextSecondary}" />
     </StackPanel>
     <Button Grid.Column="1" Style="{StaticResource GlassTileButton}"
             Content="{services:Loc Start.Settings}" Padding="11,7" Margin="5,0"
             Click="Settings_Click" />
     <Button Grid.Column="2" Style="{StaticResource GlassTileButton}"
             Content="{services:Loc Start.WindowsMenu}" Padding="11,7"
             Click="WindowsMenu_Click" />
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
