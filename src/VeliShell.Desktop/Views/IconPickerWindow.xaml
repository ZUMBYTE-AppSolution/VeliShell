<controls:VeliShellWindow x:Class="VeliShell.Desktop.Views.IconPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:VeliShell.Desktop.Controls"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 Title="{services:Loc IconPicker.Title}" Width="650" Height="650" MinWidth="540" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Border Background="{DynamicResource WindowBackdropGradient}" CornerRadius="12"
         BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
  <Grid ClipToBounds="True">
   <Grid.RowDefinitions>
    <RowDefinition Height="50" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Ellipse Grid.RowSpan="4" Width="390" Height="390" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-250,-205,0" Fill="{DynamicResource AmbientGlowGradient}" Opacity="0.1" IsHitTestVisible="False">
    <Ellipse.Effect><BlurEffect Radius="40" /></Ellipse.Effect>
   </Ellipse>
   <controls:TrafficLights HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" />
   <TextBlock Grid.Row="0" Text="{services:Loc IconPicker.Title}" FontSize="14" FontWeight="SemiBold"
              HorizontalAlignment="Center" VerticalAlignment="Center" />

   <StackPanel Grid.Row="1" Margin="28,12,28,12">
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="SearchHint" Style="{StaticResource SecondaryText}" Margin="0,7,0,0" TextWrapping="Wrap" />
    <TextBlock Text="{services:Loc IconPicker.AttributionHint}" Style="{StaticResource SecondaryText}"
               Margin="0,7,0,0" TextWrapping="Wrap" />
   </StackPanel>

   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Padding="28,0,28,18">
    <StackPanel x:Name="ResultsPanel" />
   </ScrollViewer>

   <Border Grid.Row="3" BorderBrush="{DynamicResource CardStroke}" BorderThickness="0,1,0,0" Padding="20,14">
    <Grid>
     <Button Content="{services:Loc IconPicker.OpenProvider}" HorizontalAlignment="Left" Click="OpenProvider_Click" />
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{services:Loc Common.Cancel}" Click="Cancel_Click" Margin="0,0,9,0" />
      <Button x:Name="SkipButton" Content="{services:Loc IconPicker.Skip}" Click="Skip_Click" Margin="0,0,9,0" Visibility="Collapsed" />
      <Button x:Name="ApplyButton" Content="{services:Loc IconPicker.Apply}" Style="{StaticResource PrimaryButton}"
              Click="Apply_Click" MinWidth="125" IsEnabled="False" />
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Border>
</controls:VeliShellWindow>
