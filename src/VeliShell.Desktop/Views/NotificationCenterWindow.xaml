<Window x:Class="VeliShell.Desktop.Views.NotificationCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VeliShell.Desktop.Services"
 xmlns:controls="clr-namespace:VeliShell.Desktop.Controls"
 Title="{services:Loc Notifications.Title}" Width="370" Height="480"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextPrimary}"
 ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
 UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="Window_KeyDown">
 <Border Background="{DynamicResource DockSurfaceGradient}" CornerRadius="18"
         BorderBrush="{DynamicResource DockStroke}" BorderThickness="1" Padding="1">
  <Border.Effect>
   <DropShadowEffect Color="{DynamicResource SubtleShadowColor}" BlurRadius="30" ShadowDepth="8" Opacity="0.48" />
  </Border.Effect>
  <Grid ClipToBounds="True">
   <Grid.RowDefinitions>
    <RowDefinition Height="64" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Border Grid.RowSpan="3" Background="{DynamicResource DockMilkOverlay}" CornerRadius="17" IsHitTestVisible="False" />
   <Ellipse Grid.RowSpan="2" Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-165,-135,0" Fill="{DynamicResource AmbientGlowGradient}" Opacity="0.13" IsHitTestVisible="False">
    <Ellipse.Effect><BlurEffect Radius="45" /></Ellipse.Effect>
   </Ellipse>

   <Grid Margin="20,0">
    <TextBlock Text="{services:Loc Notifications.Title}" FontSize="20" FontWeight="SemiBold"
               VerticalAlignment="Center" />
    <Button x:Name="MarkReadButton" Content="{services:Loc Notifications.MarkAllRead}"
            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"
            Click="MarkAllRead_Click" />
   </Grid>

   <Grid Grid.Row="1" Margin="12,0,12,8">
    <Grid x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="270">
     <StackPanel>
      <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoft}"
              BorderBrush="{DynamicResource AccentStroke}" BorderThickness="1" HorizontalAlignment="Center">
       <controls:VeliSymbol Symbol="Notification" Width="25" Height="25" Foreground="{DynamicResource TextPrimary}" />
      </Border>
      <TextBlock Text="{services:Loc Notifications.EmptyTitle}" FontSize="17" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Margin="0,16,0,6" />
      <TextBlock Text="{services:Loc Notifications.EmptyDescription}" Style="{StaticResource SecondaryText}"
                 TextAlignment="Center" />
     </StackPanel>
    </Grid>
    <ScrollViewer x:Name="NotificationScroller" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
     <StackPanel x:Name="NotificationItems" />
    </ScrollViewer>
   </Grid>

   <Border Grid.Row="2" BorderBrush="{DynamicResource DockInnerStroke}" BorderThickness="0,1,0,0"
           Padding="14,12">
    <Button x:Name="ClearButton" Content="{services:Loc Notifications.ClearAll}"
            HorizontalAlignment="Stretch" Click="Clear_Click" />
   </Border>
  </Grid>
 </Border>
</Window>
