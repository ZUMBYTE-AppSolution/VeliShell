<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>VeliShell</AssemblyName>
    <RootNamespace>VeliShell.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\VeliShellApp.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <Product>VeliShell</Product>
    <Title>VeliShell</Title>
    <Company>Zumbyte AppSolution</Company>
    <Authors>Zumbyte AppSolution</Authors>
    <Copyright>Copyright © 2026 Zumbyte AppSolution</Copyright>
    <Description>A calm, macOS-inspired dock and styling companion for Windows.</Description>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <DefineConstants Condition="'$(VeliShellBuildChannel)' == 'Test'">$(DefineConstants);VELISHELL_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../VeliShell.Core/VeliShell.Core.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="VeliShell.InteractionQa" /></ItemGroup>
  <ItemGroup>
    <Content Include="obj/native/VeliShell.NativeFrame.dll" Link="VeliShell.NativeFrame.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="obj/native/VeliShell.ClassicSample.exe" Link="VeliShell.ClassicSample.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="obj/native/VeliShell.NativeFrame.x86.dll" Link="VeliShell.NativeFrame.x86.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="obj/native/VeliShell.FrameBridge.x86.exe" Link="VeliShell.FrameBridge.x86.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="obj/native/VeliShell.ClassicSample.x86.exe" Link="VeliShell.ClassicSample.x86.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../WINDOW-RECOVERY.cmd" Link="WINDOW-RECOVERY.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../NATIVE-TEST.cmd" Condition="'$(VeliShellBuildChannel)' == 'Test'" Link="NATIVE-TEST.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../VM-APP-CHECK.cmd" Condition="'$(VeliShellBuildChannel)' == 'Test'" Link="VM-APP-CHECK.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../VM-APP-CHECK.md" Condition="'$(VeliShellBuildChannel)' == 'Test'" Link="VM-APP-CHECK.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../CLASSIC-APPS.cmd" Condition="'$(VeliShellBuildChannel)' == 'Test'" Link="CLASSIC-APPS.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../NATIVE-PROTOTYPE.md" Link="NATIVE-PROTOTYPE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\VeliShellApp.png" />
    <Resource Include="Assets\VeliShellMark.png" />
    <Resource Include="Assets\SystemIcons\RecycleBinEmpty.png" />
    <Resource Include="Assets\SystemIcons\RecycleBinFull.png" />
    <Resource Include="Assets\SystemIcons\FolderShortcut.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-LICENSES/**/*" Link="THIRD-PARTY-LICENSES/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildNativeFramePrototype" BeforeTargets="BeforeBuild" Inputs="../../native/VeliShell.NativeFrame/NativeFrame.cpp;../../native/VeliShell.NativeFrame/ClassicFrame.cpp;../../native/VeliShell.NativeFrame/ClassicGlass.h;../../tests/VeliShell.InteractionQa/ClassicFixture.cpp;../../tools/Build-NativePrototype.ps1" Outputs="$(MSBuildProjectDirectory)/obj/native/VeliShell.NativeFrame.dll;$(MSBuildProjectDirectory)/obj/native/VeliShell.ClassicSample.exe">
    <Exec Command="pwsh.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/Build-NativePrototype.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)/obj/native/VeliShell.NativeFrame.dll&quot; -FixturePath &quot;$(MSBuildProjectDirectory)/obj/native/VeliShell.ClassicSample.exe&quot;" />
  </Target>
  <Target Name="BuildNativeFrameX86" BeforeTargets="BeforeBuild" Inputs="../../native/VeliShell.NativeFrame/NativeFrame.cpp;../../native/VeliShell.NativeFrame/ClassicFrame.cpp;../../native/VeliShell.NativeFrame/ClassicGlass.h;../../native/VeliShell.NativeFrame/FrameBridge.cpp;../../tests/VeliShell.InteractionQa/ClassicFixture.cpp;../../tools/Build-NativePrototype.ps1" Outputs="$(MSBuildProjectDirectory)/obj/native/VeliShell.NativeFrame.x86.dll;$(MSBuildProjectDirectory)/obj/native/VeliShell.FrameBridge.x86.exe;$(MSBuildProjectDirectory)/obj/native/VeliShell.ClassicSample.x86.exe">
    <Exec Command="pwsh.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/Build-NativePrototype.ps1&quot; -Architecture x86 -OutputPath &quot;$(MSBuildProjectDirectory)/obj/native/VeliShell.NativeFrame.x86.dll&quot; -FixturePath &quot;$(MSBuildProjectDirectory)/obj/native/VeliShell.ClassicSample.x86.exe&quot; -BridgePath &quot;$(MSBuildProjectDirectory)/obj/native/VeliShell.FrameBridge.x86.exe&quot;" />
  </Target>
</Project>
